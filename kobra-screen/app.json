{
    "$version": "1",
    "name": "Kobra Screen",
    "description": "Touchscreen UI for the Anycubic Kobra 3 and ACE Pro (Moonraker / Klipper)",
    "version": "0.3.1",
    "requirements": {
        "cpu": 5,
        "memory": 25
    },
    "properties": {
        "moonraker_host": {
            "display": "Moonraker host",
            "type": "text",
            "default": "127.0.0.1"
        },
        "moonraker_port": {
            "display": "Moonraker port",
            "type": "number",
            "range": [1, 65535],
            "default": 7125
        },
        "touch_calibration": {
            "display": "Touch calibration (min_x,min_y,max_x,max_y)",
            "type": "text",
            "default": ""
        },
        "touch_swap_axes": {
            "display": "Swap touch axes",
            "type": "enum",
            "options": ["false", "true"],
            "default": "false"
        },
        "wifi_interface": {
            "display": "Wi-Fi interface",
            "type": "text",
            "default": "wlan0"
        },
        "language": {
            "display": "Language",
            "type": "enum",
            "options": ["en", "tr"],
            "default": "en"
        }
    }
}
